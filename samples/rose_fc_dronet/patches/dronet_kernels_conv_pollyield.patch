 #include <riscv_vector.h>
 #include "kernels.h"
 
+/* FC+DroNet co-residency (riskybird-fc-dronet): fence-free, preemptible mvout-DMA
+ * drain that replaces the terminal gemmini_fence() after every conv's
+ * tiled_conv_auto. A hart-stalling `fence` with an outstanding RoCC write-DMA is
+ * the hazard that corrupted DroNet output (err=10) when the PID loop preempted
+ * mid-drain -- the trap/context-switch (whose eager V save issues vse8.v) landed
+ * during the stalled fence. Instead poll the WDMA_BYTES_SENT counter, k_yield()ing
+ * while the array drains, so context switches only happen at clean instruction
+ * boundaries; the final (now-instant) fence guarantees ordering. Poll-until-quiescent
+ * (no fixed byte target -- HW bytes don't map 1:1 to OC*OH*OW) with the final fence
+ * as the backstop. Same mechanism as a28efeb's conv2d_pool_loadonce GOP_TILES_POLL,
+ * generalized to every conv (all 9 dispatch this one kernel). yield during the drain
+ * is measured bit-exact (a28efeb: errYA=0). Also fixes the fence-block that stalled
+ * the >=200 Hz control loop 16-24 ms per conv. */
+#include <zephyr/kernel.h>            /* k_yield */
+#ifndef MB_DRAIN_WDMA_SLOT
+#define MB_DRAIN_WDMA_SLOT 4
+#endif
+static inline void mb_conv_drain_yield(void)
+{
+	static int _cfg;
+	if (!_cfg) { counter_configure(MB_DRAIN_WDMA_SLOT, WDMA_BYTES_SENT); _cfg = 1; }
+	/* Only yield if IRQs are enabled: the atomic-baseline pass runs the whole
+	 * inference under an outer irq_lock, and k_yield() with IRQs locked faults. */
+	unsigned int _probe = irq_lock(); irq_unlock(_probe);
+	int _irqs_on = arch_irq_unlocked(_probe);
+	uint32_t prev = counter_read(MB_DRAIN_WDMA_SLOT);
+	int stable = 0;
+	for (int i = 0; i < 2000000 && stable < 4; i++) {
+		if (_irqs_on) { k_yield(); }
+		uint32_t cur = counter_read(MB_DRAIN_WDMA_SLOT);
+		stable = (cur == prev) ? (stable + 1) : 0;
+		prev = cur;
+	}
+	gemmini_fence();   /* safety: instant now (DMA drained), no interrupt-during-stall */
+}
+
