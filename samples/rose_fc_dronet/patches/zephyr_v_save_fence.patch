diff --git a/arch/riscv/core/v.c b/arch/riscv/core/v.c
index 80a777dc673..e0f4efc3331 100644
--- a/arch/riscv/core/v.c
+++ b/arch/riscv/core/v.c
@@ -153,6 +153,15 @@ void z_riscv_vstate_save_thread(struct k_thread *thread)
 			: "r"(save_to->vreg)
 			: "memory");
 	}
+#ifndef MB_V_SAVE_FENCE_OFF
+	/* DEFAULT ON (bench-validated): full HW fence after the eager V save. The
+	 * decoupled Saturn vector store buffer can otherwise leave the saved vregs
+	 * un-drained to memory before this thread is switched away, corrupting the
+	 * scheduler at high V-context-switch frequency (mcause-5 vstate-restore).
+	 * Adding this fence made preemptible co-resident DroNet run >70 s stable
+	 * @354 Hz (was faulting at ~34 s). Opt out with -DMB_V_SAVE_FENCE_OFF for A/B. */
+	__asm volatile("fence rw, rw" ::: "memory");
+#endif
 	save_to->is_dirty = (mstatus_v != 0);
 
 	csr_clear(mstatus, MSTATUS_VS);
@@ -199,6 +208,11 @@ void z_riscv_vstate_restore_thread(struct k_thread *thread)
 	 * to save its state. */
 	if (restore_from->is_dirty) {
 		unsigned long vl;
+#ifndef MB_V_SAVE_FENCE_OFF
+		/* DEFAULT ON (bench-validated): pair of the save-side fence -- ensure this thread's
+		 * previously-saved vregs have landed in memory before the eager reload reads them. */
+		__asm volatile("fence rw, rw" ::: "memory");
+#endif
 		__asm volatile(
 			".option push\n\t"
 			".option arch, +v\n\t"
