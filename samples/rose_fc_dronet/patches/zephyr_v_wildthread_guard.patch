+/* V-race #2 residual (atomic mcause-5): a valid k_thread lives in
+ * [CONFIG_SRAM_BASE_ADDRESS, +CONFIG_SRAM_SIZE KiB). The residual fault is an
+ * eager V save/restore invoked with a WILD thread pointer (a scheduler
+ * switch_handle clobbered upstream by a wild vector store): a wild save_to makes
+ * the bulk vse8.v itself a WILD STORE (propagating the corruption), and a wild
+ * restore_from makes the bulk vle8.v a wild load (the observed mcause-5 at
+ * z_riscv_vstate_restore_thread+0x7e). Validate the thread pointer and, if wild,
+ * RECORD it and SKIP -- preventing the wild store at its source and capturing the
+ * culprit for diagnosis. Inspect z_riscv_v_dbg_wild_{save,restore}[_ptr]. */
+volatile unsigned long z_riscv_v_dbg_wild_save, z_riscv_v_dbg_wild_save_ptr;
+volatile unsigned long z_riscv_v_dbg_wild_restore, z_riscv_v_dbg_wild_restore_ptr;
+static inline bool z_riscv_v_thread_in_ram(const struct k_thread *t)
+{
+	uintptr_t p = (uintptr_t)t;
+	return (p >= (uintptr_t)CONFIG_SRAM_BASE_ADDRESS) &&
+	       (p <  (uintptr_t)CONFIG_SRAM_BASE_ADDRESS + ((uintptr_t)CONFIG_SRAM_SIZE << 10)) &&
+	       ((p & 7UL) == 0UL);
+}
