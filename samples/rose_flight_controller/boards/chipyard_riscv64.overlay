/*
 * riskybird v3 flight controller on the FPGA Rocket (chipyard_riscv64), DroneFullDDR shell.
 *
 * Binds the REAL board sensors to the FPGA's own peripherals: BMI088 IMU / VL53L1X down-ToF /
 * BMP388 baro / 4x VL53L5CX side-ToF on i2c@10040000, PMW3901 optical flow on spi@10031000
 * (labeled spi2, with gpio@10010000 = gpio0 for the software chip-select, matching flow.c), and
 * 4 motor PWM channels on pwm@10050000 (motors are INHIBITED in this bring-up build).
 *
 * Peripheral addresses + PLIC IRQs are from the generated DTS of RocketArty200TDroneFullDDRConfig
 * (i2c=1, pwm0=2-5, uart0=10, uart1=11, gpio=12-14, spi=15, ospi=16). The base SoC dtsi defaults
 * console to HTIF; we move it to the SiFive uart0 (-> /dev/ttyUSB1) and point sram at the 1 GiB DDR.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &ram0;
	};

	aliases {
		bmi088-accel = &bmi088_accel;
		bmi088-gyro  = &bmi088_gyro;
		tof   = &vl53l1x;
		baro  = &bmp388;
		motors = &pwm_motors;
		side-back  = &side_back;
		side-front = &side_front;
		side-right = &side_right;
		side-left  = &side_left;
	};

	gpio0: gpio@10010000 {
		compatible = "sifive,gpio0";
		reg = <0x10010000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <12 1>, <13 1>, <14 1>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};

	pwm0: pwm@10050000 {
		compatible = "sifive,pwm0";
		reg = <0x10050000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <2 1>, <3 1>, <4 1>, <5 1>;
		sifive,compare-width = <16>;
		#pwm-cells = <2>;
		status = "okay";
	};

	/* PMW3901 optical-flow SPI. flow.c uses DT_NODELABEL(spi2) + gpio0 (software CS). */
	spi2: spi@10031000 {
		compatible = "sifive,spi0";
		reg = <0x10031000 0x1000>;
		reg-names = "control";
		interrupt-parent = <&plic>;
		interrupts = <15 1>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};

	/* 4 brushed-motor PWM outputs (thrust ~ duty). INHIBITED in this build (ROSE_MOTORS_INHIBIT=1). */
	pwm_motors: pwm_motors {
		compatible = "riskybird,pwm-motors";
		pwms = <&pwm0 0 50000>, <&pwm0 1 50000>, <&pwm0 2 50000>, <&pwm0 3 50000>;
	};
};

&{/cpus/cpu@0} { clock-frequency = <50000000>; };
&{/cpus/cpu@1} { status = "disabled"; };
&{/cpus/cpu@2} { status = "disabled"; };
&{/cpus/cpu@3} { status = "disabled"; };
&{/cpus/cpu@4} { status = "disabled"; };
&{/cpus/cpu@5} { status = "disabled"; };
&{/cpus/cpu@6} { status = "disabled"; };
&{/cpus/cpu@7} { status = "disabled"; };

&plic { riscv,max-priority = <7>; riscv,ndev = <20>; };

&ram0 { reg = <0x80000000 0x40000000>; status = "okay"; };

&uart0 { status = "okay"; current-speed = <115200>; interrupts = <10 1>; };

&htif  { status = "disabled"; };
&flash0 { status = "disabled"; };
&spad0 { status = "disabled"; };

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;   /* fast-mode: shortens the BMI088 IMU read (loop bottleneck) */
	interrupts = <1 1>;
	#address-cells = <1>;
	#size-cells = <0>;

	bmi088_accel: accelerometer@18 {
		compatible = "bosch,bmi08x-accel";
		reg = <0x18>;
		accel-hz = "800";
		accel-fs = <6>;
		status = "okay";
	};
	bmi088_gyro: gyroscope@68 {
		compatible = "bosch,bmi08x-gyro";
		reg = <0x68>;
		gyro-hz = "1000_116";
		gyro-fs = <1000>;
		status = "okay";
	};

	/* down-ToF: powers up at 0x29; main.cpp readdresses it to 0x30 at boot (ADS7128 GPIO6 XSHUT). */
	vl53l1x: vl53l1x@30 {
		compatible = "st,vl53l1x";
		reg = <0x30>;
		status = "okay";
	};

	bmp388: bmp388@76 {
		compatible = "bosch,bmp388";
		reg = <0x76>;
		odr = "50";
		osr-press = <8>;
		osr-temp = <1>;
		iir-filter = <3>;
		status = "okay";
	};

	/* 4 side VL53L5CX (bumper). Default 0x29; side_tof.c enables+readdresses to 0x31-0x34 at runtime. */
	side_back:  vl53l5cx@31 { compatible = "st,vl53l5cx"; reg = <0x31>; };
	side_front: vl53l5cx@32 { compatible = "st,vl53l5cx"; reg = <0x32>; };
	side_right: vl53l5cx@33 { compatible = "st,vl53l5cx"; reg = <0x33>; };
	side_left:  vl53l5cx@34 { compatible = "st,vl53l5cx"; reg = <0x34>; };
};
