/*
 * fpga_telem_bridge overlay (esp32c6_devkitc/esp32c6/hpcore).
 *  - Debug console on USB-serial-JTAG, freeing UART0 for the FPGA link.
 *  - UART0 = the FPGA link: ESP U0TXD (GPIO16) -> FPGA E13 (rxd),
 *                           ESP U0RXD (GPIO17) <- FPGA F14 (txd), @ 115200.
 *  - Enable the on-chip 2.4 GHz WiFi radio for the SoftAP.
 */
/ {
	chosen {
		zephyr,console = &usb_serial;
		riskybird,fpga-uart = &uart0;
	};
};

&wifi {
	status = "okay";
};

&usb_serial {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};
