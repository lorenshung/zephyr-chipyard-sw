# Bootstrap downloads / generated toolchain (see README "Standalone Installation").
# conda (scripts/install_conda.sh)
/tools/miniforge3/
/tools/Miniforge3-Linux-x86_64.sh
# Zephyr SDK (scripts/install_toolchain_sdk.sh)
/tools-manual/
# west workspace deps fetched by `west update` (the zephyr kernel is a submodule, kept)
/zephyr_ws/.west/
/zephyr_ws/bootloader/
/zephyr_ws/modules/
/zephyr_ws/tools/
# logs / build output
.install_submodules.log
.install_conda.log
/build/

# COCO-pretrained YOLOv8n weights; ultralytics downloads this on demand
# (YOLO("yolov8n.pt") in modelblaster/examples/yolov8_nano).
/yolov8n.pt

# Integrated FPGA bench outputs
# west build directories (one per experiment) — generated, never tracked
/build_*/
/fpu_build/
# DroNet build-flow output — regenerated by scripts/build_fc_dronet.sh from the
# modelblaster kernel sources (curated kernels live in the modelblaster submodule).
# Weights, model, buffers, test vectors and the pick manifest are all generated.
/samples/rose_fc_dronet/dronet_model/
/samples/rose_fc_dronet/dronet_model_lo/
/samples/rose_fc_dronet/dronet_model_poll/buffers.c
/samples/rose_fc_dronet/dronet_model_poll/model.c
/samples/rose_fc_dronet/dronet_model_poll/model.h
/samples/rose_fc_dronet/dronet_model_poll/weights.c
/samples/rose_fc_dronet/dronet_model_poll/weights.h
/samples/rose_fc_dronet/dronet_model_poll/kernels.h
/samples/rose_fc_dronet/dronet_model_poll/kernel_picks.json
/samples/rose_fc_dronet/dronet_model_poll/test_golden.bin
/samples/rose_fc_dronet/dronet_model_poll/test_input.bin
/samples/rose_fc_dronet/dronet_model_poll/test_io.S
