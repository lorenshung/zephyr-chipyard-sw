/*
 * RiskyBird ESP32-C6 base-board contract.
 *
 * This wiring is derived from the previously deployed BMI088 application.
 * It remains declared, rather than newly measured, until an in-repository
 * hardware capture confirms the addresses and identities.
 */

/* The populated ESP32-C6FH4 carries 4 MiB, not the devkit target's 8 MiB. */
&flash0 {
	reg = <0x0 DT_SIZE_M(4)>;
};

&pinctrl {
	riskybird_i2c0_default: riskybird_i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO15>,
				 <I2C0_SCL_GPIO14>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&riskybird_i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	bmi088_accel: accelerometer@18 {
		compatible = "bosch,bmi08x-accel";
		reg = <0x18>;
		accel-hz = "200";
		accel-fs = <6>;
		status = "okay";
	};

	bmi088_gyro: gyroscope@68 {
		compatible = "bosch,bmi08x-gyro";
		reg = <0x68>;
		gyro-hz = "200_64";
		gyro-fs = <1000>;
		status = "okay";
	};
};

/ {
	aliases {
		bmi088-accel = &bmi088_accel;
		bmi088-gyro = &bmi088_gyro;
	};
};
