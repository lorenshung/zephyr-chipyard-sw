/*
 * RiskyBird logical drone-peripheral contract for Chipyard DroneLogic
 * configurations.
 *
 * The addresses and interrupt IDs below are derived from elaborated Chipyard
 * DTS output. They do not assign FPGA package pins. A target may only be
 * considered physically deployable after its harness/constraints route these
 * logical signals to verified board connectors at compatible I/O voltages.
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &ram0;
	};

	aliases {
		bmi088-accel = &bmi088_accel;
		bmi088-gyro = &bmi088_gyro;
	};

	gpio0: gpio@10010000 {
		compatible = "sifive,gpio0";
		reg = <0x10010000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <11 1>, <12 1>, <13 1>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};

	pwm0: pwm@10050000 {
		compatible = "sifive,pwm0";
		reg = <0x10050000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <2 1>, <3 1>, <4 1>, <5 1>;
		sifive,compare-width = <16>;
		#pwm-cells = <2>;
		status = "okay";
	};

	pwm1: pwm@10051000 {
		compatible = "sifive,pwm0";
		reg = <0x10051000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <6 1>, <7 1>, <8 1>, <9 1>;
		sifive,compare-width = <16>;
		#pwm-cells = <2>;
		status = "okay";
	};

	spi0: spi@10031000 {
		compatible = "sifive,spi0";
		reg = <0x10031000 0x1000>;
		reg-names = "control";
		interrupt-parent = <&plic>;
		interrupts = <14 1>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};
};

&{/cpus/cpu@0} {
	clock-frequency = <50000000>;
};

&{/cpus/cpu@1} {
	status = "disabled";
};

&{/cpus/cpu@2} {
	status = "disabled";
};

&{/cpus/cpu@3} {
	status = "disabled";
};

&{/cpus/cpu@4} {
	status = "disabled";
};

&{/cpus/cpu@5} {
	status = "disabled";
};

&{/cpus/cpu@6} {
	status = "disabled";
};

&{/cpus/cpu@7} {
	status = "disabled";
};

&plic {
	riscv,max-priority = <7>;
	riscv,ndev = <15>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	interrupts = <10 1>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
	interrupts = <1 1>;

	bmi088_accel: accelerometer@18 {
		compatible = "bosch,bmi08x-accel";
		reg = <0x18>;
		accel-hz = "200";
		accel-fs = <6>;
	};

	bmi088_gyro: gyroscope@68 {
		compatible = "bosch,bmi08x-gyro";
		reg = <0x68>;
		gyro-hz = "200_64";
		gyro-fs = <1000>;
	};
};

&htif {
	status = "disabled";
};

&flash0 {
	status = "disabled";
};

&spad0 {
	status = "disabled";
};
