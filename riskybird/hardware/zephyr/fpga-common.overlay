/*
 * Common Zephyr corrections for the one-hart RiskyBird FPGA shells.
 *
 * The backend's chipyard_riscv64 board is intentionally generic and based on
 * an eight-hart QEMU DTS. These overrides describe the generated Rocket shells
 * without changing the backend.
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &ram0;
	};

	aliases {
		bmi088-accel = &bmi088_accel;
		bmi088-gyro = &bmi088_gyro;
	};
};

&{/cpus/cpu@0} {
	clock-frequency = <50000000>;
};

&{/cpus/cpu@1} {
	status = "disabled";
};

&{/cpus/cpu@2} {
	status = "disabled";
};

&{/cpus/cpu@3} {
	status = "disabled";
};

&{/cpus/cpu@4} {
	status = "disabled";
};

&{/cpus/cpu@5} {
	status = "disabled";
};

&{/cpus/cpu@6} {
	status = "disabled";
};

&{/cpus/cpu@7} {
	status = "disabled";
};

&plic {
	riscv,max-priority = <3>;
	riscv,ndev = <3>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	interrupts = <2 1>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
	interrupts = <1 1>;

	bmi088_accel: accelerometer@18 {
		compatible = "bosch,bmi08x-accel";
		reg = <0x18>;
		accel-hz = "200";
		accel-fs = <6>;
	};

	bmi088_gyro: gyroscope@68 {
		compatible = "bosch,bmi08x-gyro";
		reg = <0x68>;
		gyro-hz = "200_64";
		gyro-fs = <1000>;
	};
};

&htif {
	status = "disabled";
};

&flash0 {
	status = "disabled";
};

&spad0 {
	status = "disabled";
};
